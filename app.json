{
  "expo": {
    "name": "Ping!",
    "slug": "ping-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.pingapp",
      "infoPlist": {
        "NSContactsUsageDescription": "Ping! usa i tuoi contatti per trovare gli amici che hanno l app.",
        "NSPhotoLibraryUsageDescription": "Ping! usa la galleria per scegliere la tua foto profilo."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#C84FD6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.example.pingapp",
      "permissions": [
        "READ_CONTACTS",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-audio",
      "expo-secure-store",
      [
        "expo-contacts",
        {
          "contactsPermission": "Ping! usa i tuoi contatti per trovare gli amici che hanno l app."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ping! usa la galleria per scegliere la tua foto profilo."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C84FD6"
        }
      ]
    ],
    "scheme": "pingapp",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#C84FD6"
    },
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
